# KicksHub - Environment Example

# Backend environment variables (do NOT commit secrets to source)
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/kickshub

# JWT secret for signing tokens
JWT_SECRET=your_jwt_secret_here

# Stripe keys (use test keys for local development)
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_key

# Node environment
NODE_ENV=development
PORT=5000
